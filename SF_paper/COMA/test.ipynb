   "source": [
    "import sympy as sp\n",
    "\n",
    "s, ds = sp.symbols('x_0, {\\delta}x')\n",
    "se, dse = sp.symbols('x_0^{\\prime}, {\\delta}x^{\\prime}')\n",
    "\n",
    "eq1 = (((s+ds) - (se+dse))**2).expand()\n",
    "eq2 = (((s-ds) - (se-dse))**2).expand()\n",
    "\n",
    "display(eq1)\n",
    "display(eq2)\n"
   ]
